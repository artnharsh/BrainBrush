      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "game_rooms_active or vector(0)",
          "legendFormat": "Rooms",
          "refId": "A"
        }
      ]
