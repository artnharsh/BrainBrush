{# =========================================================================
   BACKEND ENVIRONMENT FILE — Jinja2 Template
   =========================================================================

   🎓 HOW DO SECRETS FLOW IN THIS PIPELINE?
   
   1. You store secrets in Jenkins (Manage Jenkins → Credentials)
   2. Jenkinsfile reads them using withCredentials() block
   3. Jenkins passes them to Ansible via --extra-vars
   4. Ansible uses this Jinja2 template to write them into the .env file
   5. Docker Compose reads .env and injects them into the container

   The secret NEVER appears in code, Git, or logs. It flows:
   Jenkins Credentials → Ansible vars → .env file on server → container env
   
   🎓 WHY NOT JUST COPY A .env FILE?
   Because .env files should NEVER be in Git (they contain passwords).
   Using a template means the values are injected at deploy time from
   a secure credential store (Jenkins), not from a file in your repo.
   ========================================================================= #}
# ===========================================
# BrainBrush Backend Environment Variables
# Auto-generated by Ansible — DO NOT EDIT MANUALLY
# ===========================================

PORT=5000
MONGO_URI={{ mongo_uri }}
REDIS_URL={{ redis_url }}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
JWT_SECRET={{ jwt_secret }}
FRONTEND_URL={{ frontend_url | default('http://localhost') }}
