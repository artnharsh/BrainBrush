{# =========================================================================
   PRODUCTION DOCKER COMPOSE — Jinja2 Template
   =========================================================================

   🎓 WHAT IS JINJA2?
   Jinja2 is a templating language (used by Ansible, Flask, Django, etc.).
   Anything inside {{ }} gets replaced with actual values when Ansible
   processes this template.

   🎓 WHY IS THIS A TEMPLATE AND NOT A PLAIN FILE?
   Because the Docker image tag changes with each deployment.
   Jenkins might deploy tag "v1.0.0" today and "v1.1.0" tomorrow.
   The template lets Ansible inject the correct tag dynamically.

   🎓 HOW IS THIS DIFFERENT FROM docker-compose.yml?
   - docker-compose.yml (dev): Uses `build: ./backend` to build FROM SOURCE
   - docker-compose.prod.yml: Uses `image:` to pull PRE-BUILT images from Docker Hub
   In production, you never build on the server — you pull pre-tested images.
   ========================================================================= #}
services:

  backend:
    image: {{ docker_hub_user }}/brainbrush-backend:{{ docker_image_tag }}
    container_name: brainbrush-backend
    restart: unless-stopped
    ports:
      - "5000:5000"
    env_file:
      - .env
    environment:
      - PORT=5000

  frontend:
    image: {{ docker_hub_user }}/brainbrush-frontend:{{ docker_image_tag }}
    container_name: brainbrush-frontend
    restart: unless-stopped
    ports:
      - "80:80"
    depends_on:
      - backend
