services:

  backend:
    image: {{ docker_hub_user }}/brainbrush-backend:{{ docker_image_tag }}
    container_name: brainbrush-backend
    restart: unless-stopped
    ports:
      - "5000:5000"
    env_file:
      - .env
    environment:
      - PORT=5000
      - NODE_OPTIONS=--max-old-space-size=200
    deploy:
      resources:
        limits:
          memory: 250M

  frontend:
    image: {{ docker_hub_user }}/brainbrush-frontend:{{ docker_image_tag }}
    container_name: brainbrush-frontend
    restart: unless-stopped
    ports:
      - "80:80"
    depends_on:
      - backend
    deploy:
      resources:
        limits:
          memory: 100M
